# Installed by Netwatch's install.sh as
# /etc/systemd/system/prometheus-node-exporter.service.d/netwatch.conf, with @LISTEN@ replaced by
# NETWATCH_METRICS_LISTEN. It replaces the package's ExecStart, so the ARGS in
# /etc/default/prometheus-node-exporter are not used; editing that file would make it a modified
# conffile, which unattended-upgrades then refuses to upgrade.
[Unit]
# It listens on one LAN address, which may come from DHCP a few seconds into boot. Binding before
# the address exists fails with "cannot assign requested address".
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=
ExecStart=/usr/bin/prometheus-node-exporter \
    --web.listen-address=@LISTEN@:9100 \
    --collector.textfile.directory=/var/lib/netwatch-metrics \
    --collector.systemd.unit-include=(netwatch-.+|dnsmasq)[.](service|timer) \
    --collector.systemd.enable-restarts-metrics
# If the address is still missing (or goes away and comes back), keep retrying. The package's
# default of 100 ms between restarts uses up systemd's start limit (5 starts in 10 s) in half a
# second and leaves the service failed for good; at 5 s the limit is never reached.
RestartSec=5s

# Sandboxing the package leaves out. node_exporter reads /proc and /sys and asks systemd over
# D-Bus for unit states; it writes nothing and needs no capabilities.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# No ProtectClock=: its seccomp filter also blocks reading the clock's sync state (adjtimex),
# which the timex collector needs. Without CAP_SYS_TIME the process can't set the clock anyway.
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
