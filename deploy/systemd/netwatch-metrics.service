# Writes Netwatch's Prometheus metrics for node_exporter's textfile collector (netwatch metrics).
# Started every minute by netwatch-metrics.timer.
[Unit]
Description=Netwatch Prometheus metrics
Documentation=https://github.com/iMovingTarget/netwatch

[Service]
Type=oneshot
User=netwatch
Group=netwatch
EnvironmentFile=/etc/netwatch/netwatch.env
EnvironmentFile=/opt/netwatch/current/revision.env
ExecStart=/opt/netwatch/current/venv/bin/netwatch metrics --output /var/lib/netwatch-metrics/netwatch.prom
StateDirectory=netwatch
StateDirectoryMode=0750
# install.sh creates this directory (netwatch:netwatch 0755) so node_exporter can read the file.
ReadWritePaths=/var/lib/netwatch-metrics
UMask=0027
TimeoutStartSec=30s
# A run every minute would otherwise put "Starting"/"Finished" in the journal 2,880 times a day.
# LogLevelMax also filters the program's own output, which journald logs at SyslogLevel (info by
# default); at warning, the one-line reason for a failed run still gets through.
LogLevelMax=notice
SyslogLevel=warning

# Sandboxing. It reads the database (opened read-only; SQLite still needs the state directory to
# be writable for its shared-memory file) and writes one file. It has no network at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
