# Scans the LAN once with ARP and records who answered (netwatch devices scan). Started every five
# minutes by netwatch-discovery.timer, and once by install.sh to record the baseline.
[Unit]
Description=Netwatch LAN device scan
Documentation=https://github.com/iMovingTarget/netwatch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=netwatch
Group=netwatch
EnvironmentFile=/etc/netwatch/netwatch.env
EnvironmentFile=/opt/netwatch/current/revision.env
ExecStart=/opt/netwatch/current/venv/bin/netwatch devices scan
StateDirectory=netwatch
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=2min

# Sending raw ARP frames needs CAP_NET_RAW, and it is the only capability this service has.
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW

# Sandboxing. It sends and receives ARP frames on the LAN interface, reads the IEEE registry and
# writes only /var/lib/netwatch. No PrivateNetwork= or PrivateUsers=: either would cut it off from
# the host's interfaces or void the capability. AF_INET is there only to ask the kernel for the
# interface's address; IPAddressDeny=any stops any IP packet in or out.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_PACKET AF_INET AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
