# Phase 0 walking skeleton: proves the deploy pipeline before any features exist.
# Replaced by the DNS service in Phase 1; install.sh then removes this unit.
[Unit]
Description=Netwatch walking skeleton (deploy pipeline check)
Documentation=https://github.com/iMovingTarget/netwatch

[Service]
Type=simple
User=netwatch
Group=netwatch
EnvironmentFile=/etc/netwatch/netwatch.env
EnvironmentFile=/opt/netwatch/current/revision.env
ExecStart=/opt/netwatch/current/venv/bin/netwatch skeleton
Restart=on-failure
RestartSec=5s
StateDirectory=netwatch
StateDirectoryMode=0750
UMask=0027

# Sandboxing. The service only needs to read its code and write /var/lib/netwatch.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
