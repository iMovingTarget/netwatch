# Netwatch settings. install.sh copies this to /etc/netwatch/netwatch.env (owner root, group
# netwatch, mode 0640) on the first install and never overwrites it afterwards. Lists are
# comma-separated. After changing a DNS or discovery setting, run install.sh again to apply it.
# Secrets added in later phases, such as the Telegram bot token, belong in that file only, never in
# the repository.

# DEBUG, INFO, WARNING or ERROR
NETWATCH_LOG_LEVEL=INFO

# --- DNS (Phase 1) ---
# The LAN address(es) of this host that dnsmasq answers on. Leave empty to skip the DNS setup.
NETWATCH_DNS_LISTEN=
# Networks allowed through ufw to port 53, for example your LAN: 192.0.2.0/24
NETWATCH_DNS_ALLOW_FROM=
# Where dnsmasq forwards queries that aren't blocked.
NETWATCH_DNS_UPSTREAMS=1.1.1.1,9.9.9.9
# Blocklists to download daily (https only); hosts format or one domain per line.
NETWATCH_BLOCKLIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# How long to keep stored queries.
NETWATCH_DNS_RETENTION_DAYS=30

# --- Failed-login detection (Phase 2) ---
# Raise an alert when one address fails to log in over SSH this many times ...
NETWATCH_AUTH_MAX_FAILURES=5
# ... within this many minutes.
NETWATCH_AUTH_WINDOW_MINUTES=10
# How long to keep login events and SSH alerts.
NETWATCH_AUTH_RETENTION_DAYS=90

# --- LAN device discovery (Phase 3) ---
# The LAN interface whose IPv4 subnet is scanned with ARP every five minutes, for example eth0.
# Leave empty to keep discovery off. The first scan is the baseline: the devices it finds are
# recorded as known; any device seen for the first time after it raises a new-device alert.
NETWATCH_DISCOVERY_INTERFACE=
# How long to keep the history of which device had which address, and new-device alerts.
NETWATCH_DISCOVERY_RETENTION_DAYS=90
