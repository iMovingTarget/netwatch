# Netwatch settings. install.sh copies this to /etc/netwatch/netwatch.env (owner root, group
# netwatch, mode 0640) on the first install and never overwrites it afterwards.
# Secrets added in later phases, such as the Telegram bot token, belong in that file only, never in
# the repository.

# DEBUG, INFO, WARNING or ERROR
NETWATCH_LOG_LEVEL=INFO
