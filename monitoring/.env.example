# Settings for this monitoring host. setup.sh copies this file to .env on the first run and never
# overwrites it; edit .env and run setup.sh again to apply a change. .env is not committed.

# This host's LAN address; Grafana listens on port 3000 there.
GRAFANA_LISTEN=192.0.2.201
# The Netwatch host's node_exporter (NETWATCH_METRICS_LISTEN in its netwatch.env), port 9100.
NETWATCH_TARGET=192.0.2.200:9100
# How long Prometheus keeps data, and the most disk it may use for it; the first limit reached wins.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=5GB
