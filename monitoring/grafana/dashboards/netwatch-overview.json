      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(netwatch_dns_queries_total{job=\"netwatch\"}[24h]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
